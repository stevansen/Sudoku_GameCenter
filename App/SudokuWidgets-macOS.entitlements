<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Auch die Erweiterung muss in der Sandbox laufen. Sie leitet das
	     Tagesrätsel aus dem Datum ab und braucht weder Netz noch Dateien. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
