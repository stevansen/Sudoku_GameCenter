    "Auf „%@“ läuft ein anderes Rätsel (%lld von 81 Feldern, %@). Welches möchtest du fortsetzen?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf „%@“ läuft ein anderes Rätsel (%lld von 81 Feldern, %@). Welches möchtest du fortsetzen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A different puzzle is in progress on “%1$@” (%2$lld of 81 cells, %3$@). Which one would you like to continue?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su «%1$@» è in corso un altro schema (%2$lld caselle su 81, %3$@). Quale vuoi riprendere?"
          }
        }
      }
    },
    "Auf „%@“ steht dasselbe Rätsel anders (%lld von 81 Feldern, %lld Züge). Welchen Stand möchtest du behalten?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf „%@“ steht dasselbe Rätsel anders (%lld von 81 Feldern, %lld Züge). Welchen Stand möchtest du behalten?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same puzzle stands differently on “%1$@” (%2$lld of 81 cells, %3$lld moves). Which version would you like to keep?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su «%1$@» lo stesso schema è a un punto diverso (%2$lld caselle su 81, %3$lld mosse). Quale versione vuoi tenere?"
          }
        }
      }
    },
